# PostgreSQL connection string. Matches docker-compose.yml by default.
DATABASE_URL="postgresql://postgres:shabani@localhost:5433/mhcp?schema=public"

# Auth.js secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Base URL of the app, used to build links in emails (verification, password reset).
APP_URL="http://localhost:3000"

# SMTP server for sending real emails (e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.mailtrap.io).
# Leave unset to fall back to logging emails to the console instead of sending them.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# "From" address for outgoing emails.
EMAIL_FROM="no-reply@example.com"
